# Managed by ansible.
# file: {{ template_destpath }}

# ============================================================================
# Apache HTTP Server default-deny virtual host
#
# Purpose:
#   Provide a security-only first vhost for configured listeners. This is not
#   an application virtual host and intentionally serves no content.
# ============================================================================

{% for __httpd_listener in httpd_listen %}
{% set __httpd_vhost_address = __httpd_listener.address | default('*', true) %}
{% if ':' in __httpd_vhost_address and not __httpd_vhost_address.startswith('[') %}
<VirtualHost [{{ __httpd_vhost_address }}]:{{ __httpd_listener.port }}>
{% else %}
<VirtualHost {{ __httpd_vhost_address }}:{{ __httpd_listener.port }}>
{% endif %}
    ServerName {{ httpd_default_vhost_server_name }}

{% if __httpd_listener.protocol | default('http') == 'https' %}
    SSLEngine on
    SSLCertificateFile "{{ __httpd_default_vhost_certificate_file }}"
    SSLCertificateKeyFile "{{ __httpd_default_vhost_certificate_key_file }}"

{% endif %}
    <Location />
        Require all denied
    </Location>

    ErrorLog "{{ __httpd_error_log }}"
    <IfModule log_config_module>
        CustomLog "{{ __httpd_access_log }}" combined
    </IfModule>
</VirtualHost>

{% endfor %}
