# Managed by ansible.
# file: {{ template_destpath }}

# ============================================================================
# Apache HTTP Server global Listen configuration
#
# Purpose:
#   Explicitly define which TCP ports Apache listens on.
#   Nothing else belongs into this file.
#
# Notes:
#   - A Listen directive does not define a virtual host.
#   - The role may render a security-only default-deny virtual host separately.
#   - Application VirtualHost definitions are managed separately.
# ============================================================================

{% for __httpd_listener in httpd_listen %}
{% set __httpd_listener_address = __httpd_listener.address | default('') %}
{% set __httpd_listener_protocol = (' ' ~ __httpd_listener.protocol) if __httpd_listener.protocol is defined and __httpd_listener.protocol | length > 0 else '' %}
{% if __httpd_listener_address | length > 0 %}
{% if ':' in __httpd_listener_address and not __httpd_listener_address.startswith('[') %}
Listen [{{ __httpd_listener_address }}]:{{ __httpd_listener.port }}{{ __httpd_listener_protocol }}
{% else %}
Listen {{ __httpd_listener_address }}:{{ __httpd_listener.port }}{{ __httpd_listener_protocol }}
{% endif %}
{% else %}
Listen {{ __httpd_listener.port }}{{ __httpd_listener_protocol }}
{% endif %}
{% endfor %}
