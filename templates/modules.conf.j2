# Managed by ansible.
# file: {{ template_destpath }}

# ============================================================================
# Apache HTTP Server module configuration
#
# Purpose:
#   Load the selected platform MPM module when required, the role-required
#   minimal module set, the role-required TLS module set, and explicitly
#   configured extra modules.
# ============================================================================

{% for __httpd_module in (
    ([__httpd_mpm_modules[httpd_mpm]] if httpd_mpm in __httpd_mpm_modules else [])
    + __httpd_minimal_modules
    + (__httpd_tls_modules if 'https' in httpd_listen | map(attribute='protocol', default='http') else [])
    + httpd_extra_modules
) | unique(attribute='name', case_sensitive=true) %}
LoadModule {{ __httpd_module.name }} {{ __httpd_module.path if __httpd_module.path | default('') else __httpd_module_dir ~ '/' ~ __httpd_module.file }}
{% endfor %}
